# Environment Variables Configuration

# Database (PostgreSQL) - Required in Milestone 2
DATABASE_URL=postgresql://user:password@localhost:5432/ludo?schema=public

# Authentication (Google OAuth & Session Secret) - Required in Milestone 3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# WebSocket Credential Signing Secret - Required in Milestone 3 & 6
WS_TOKEN_SECRET=

# Redis (Upstash Redis or self-hosted) - Required in Milestone 5
REDIS_URL=redis://default:password@localhost:6379

# Web Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# WebSocket Service
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

