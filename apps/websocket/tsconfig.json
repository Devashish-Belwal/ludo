{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "CommonJS",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@ludo/shared": [
        "../../packages/shared/src/index.ts",
        "../../packages/shared/dist/index.d.ts"
      ],
      "@ludo/redis": [
        "../../packages/redis/src/index.ts",
        "../../packages/redis/dist/index.d.ts"
      ],
      "@ludo/game-engine": [
        "../../packages/game-engine/src/index.ts",
        "../../packages/game-engine/dist/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*"]
}
