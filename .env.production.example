# ==============================================================================
# Production Environment Variables Template (.env on AWS EC2)
# ==============================================================================

# 1. Database (PostgreSQL / Neon / Supabase / RDS)
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/ludo?sslmode=require

# 2. Authentication (NextAuth v5 & Google OAuth)
AUTH_SECRET=generate-a-strong-random-secret-here-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# 3. WebSocket Handshake Signing Secret (Must match between Next.js and WebSocket service)
WS_TOKEN_SECRET=generate-a-strong-token-secret-here-with-openssl-rand-base64-32

# 4. Redis (Upstash Redis or self-hosted Redis)
REDIS_URL=rediss://default:your-token@your-redis-host.upstash.io:6379

# 5. Public Application URLs (Change to your EC2 Public IP or Domain)
NEXT_PUBLIC_APP_URL=http://your-ec2-public-ip
CLIENT_URL=http://your-ec2-public-ip

# 6. WebSocket Service
WS_PORT=3001
NEXT_PUBLIC_WS_URL=ws://your-ec2-public-ip:3001

# 7. Production Node Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
