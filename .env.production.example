# Production Environment Variables Template
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/ludo?sslmode=require
AUTH_SECRET=generate-a-strong-random-secret-here-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
AUTH_URL=https://ludo.dabelwal.online
NEXTAUTH_URL=https://ludo.dabelwal.online
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
WS_TOKEN_SECRET=generate-a-strong-token-secret-here-with-openssl-rand-base64-32
REDIS_URL=rediss://default:your-token@your-redis-host.upstash.io:6379
NEXT_PUBLIC_APP_URL=https://ludo.dabelwal.online
CLIENT_URL=https://ludo.dabelwal.online
WS_PORT=3001
NEXT_PUBLIC_WS_URL=wss://ludo.dabelwal.online/ws
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
